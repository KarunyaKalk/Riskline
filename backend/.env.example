# App Configuration
PROJECT_NAME="DevOps Change Intelligence & Risk Platform"
ENVIRONMENT="development"
DEBUG=True

# Database & Vector Store
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/devops_risk_db"
# Use db service name when running inside Docker Compose:
# DATABASE_URL="postgresql://postgres:postgres@db:5432/devops_risk_db"

# JWT Security
JWT_SECRET_KEY="change-this-in-production-super-secret-key-for-devops-platform"
JWT_REFRESH_SECRET_KEY="change-this-in-production-super-secret-refresh-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Origins (comma-separated or JSON list)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# LLM Configuration (Pluggable: mock, openai, gemini)
LLM_PROVIDER="mock"
OPENAI_API_KEY=""
GEMINI_API_KEY=""
